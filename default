limit_req_zone $binary_remote_addr zone=flood:10m rate=15r/s;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name aezamine.com my.aezamine.com;

    ssl_certificate /etc/letsencrypt/live/aezamine.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aezamine.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;

    server_tokens off;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    client_body_buffer_size 10K;
    client_header_buffer_size 1k;
    client_max_body_size 8m;
    large_client_header_buffers 2 1k;

    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 10s;

    # СБРОС КЭША ДЛЯ JSON (Команда/Стафф всегда будет свежей)
    location = /staff.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        try_files $uri =404;
    }

    # СБРОС КЭША ДЛЯ СКРИПТОВ, СТИЛЕЙ И СТРАНИЦ
    location ~* \.(html|js|css)$ {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        try_files $uri $uri/ =404;
    }

    location / {
        limit_req zone=flood burst=20 nodelay;
        limit_conn conn_limit 10;

        if ($request_method !~ ^(GET|HEAD|POST)$) {
            return 444;
        }

        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name aezamine.com my.aezamine.com;
    return 301 https://$host$request_uri;
}

